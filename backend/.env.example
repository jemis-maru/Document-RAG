# Free key from https://aistudio.google.com/apikey -- used for answers and for
# reading chart pages. Embeddings and reranking run locally (no key, no quota).
GEMINI_API_KEY=paste_your_key_here
CHAT_MODEL=gemini-3.6-flash

DATABASE_URL=postgresql://bacancy:devpass@localhost:5432/docrag
CORS_ORIGIN=http://localhost:3200

# Local models (downloaded once from Hugging Face, then cached)
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIMS=384
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Upload limits
MAX_PAGES=250
MAX_UPLOAD_MB=40

# Chart pages -> Gemini vision. Only for documents up to VISION_DOC_MAX_PAGES,
# at most VISION_MAX_PAGES pages each, cached forever per file.
ENABLE_VISION=true
VISION_DOC_MAX_PAGES=40
VISION_MAX_PAGES=15

# Chunking
CHUNK_CHARS=1200
CHUNK_OVERLAP=200

# Retrieval
CANDIDATES=30
RETRIEVE_K=6
MIN_RERANK_SCORE=-4
ENABLE_SECTION_SCOPE=true
ENABLE_NEIGHBORS=true
MAX_CONTEXT_CHARS=12000
ENABLE_QUERY_REWRITE=true
